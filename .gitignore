# Keys kept on one computer (the FRED API key): never committed
secrets.yml

# Vendored engine wheels for the container build
wheels/*
!wheels/.keep
data/

# Deployment state, not source -- like runs/: the project audit log, the
# archived calculator code and the config versions a deployment creates.
logs/
calculator_versions/
config_snapshots/
# the calculator registry: written by the app the first time a version runs
config/calculator_versions.yml

# The macro store: fetched data, a deployment keeps its own vintages
macro_store/
# Saved stress scenarios: the deployment's own database
scenarios/

# The launcher's logs (start_ifrs9.bat)
launcher_logs/
